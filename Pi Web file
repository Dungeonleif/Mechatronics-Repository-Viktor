# =========================================================
# ROUTE
# =========================================================
@app.route("/")
def home():

    return render_template_string(

        HTML,

        ip=get_ip(),

        temp=get_cpu_temp(),

        cpu=get_cpu_usage(),

        ram=get_ram_usage(),

        disk=get_disk_usage(),

        uptime=get_uptime()
    )

# =========================================================
# MAIN
# =========================================================
if __name__ == "__main__":

    print("Starting Raspberry Pi Dashboard...")
    print(f"Open browser: http://{get_ip()}:5000")

    app.run(

        host="0.0.0.0",

        port=5000,

        debug=False
    )
