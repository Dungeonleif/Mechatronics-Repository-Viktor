    width: 640px;
    border-radius: 10px;
    border: 4px solid #333;
    margin-top: 20px;
}

.info {
    margin: 20px;
    font-size: 22px;
}

.instructions {
    margin-top: 20px;
    font-size: 20px;
    color: orange;
}

button {
    width: 220px;
    height: 60px;
    margin: 10px;
    font-size: 18px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
}

.auto {
    background: green;
    color: white;
}

.stop {
    background: red;
    color: white;
}

</style>

</head>

<body>

<h1>🟠 Orange Auto Rover</h1>

<div class="info">

<p><b>IP:</b> {{ ip }}</p>

<p><b>Status:</b> {{ action }}</p>

<p><b>Auto Mode:</b> {{ auto }}</p>

</div>

<img src="/video_feed">

<div class="instructions">

<p>
Hold Keys To Drive:<br><br>

W = Forward<br>
S = Backward<br>
A = Left<br>
D = Right
</p>

</div>

<button class="auto" onclick="toggleAuto()">
Toggle Auto Mode
</button>

<button class="stop" onclick="stopRobot()">
STOP
</button>

<script>

let keysPressed = {}

function sendCommand(command) {
    fetch("/" + command)
}

document.addEventListener("keydown", function(event) {

    let key = event.key.toLowerCase()

    if (keysPressed[key]) {
        return
    }

    keysPressed[key] = true

    // Disable manual control during auto mode
    if ("{{ auto }}" === "ON") {
        return
    }

    if (key === "w") {
        sendCommand("forward")
    }

    else if (key === "s") {
        sendCommand("backward")
    }

    else if (key === "a") {
        sendCommand("left")
    }

    else if (key === "d") {
        sendCommand("right")
    }

})

document.addEventListener("keyup", function(event) {

    let key = event.key.toLowerCase()

    delete keysPressed[key]

    if (
        key === "w" ||
        key === "s" ||
        key === "a" ||
        key === "d"
    ) {

        sendCommand("stop")
    }

})

function toggleAuto() {

    fetch("/toggle_auto")
    .then(() => location.reload())
}

function stopRobot() {

    fetch("/stop")
    .then(() => location.reload())
}

</script>

</body>
</html>
"""

# =========================================================
# ROUTES
# =========================================================
@app.route("/")
def home():

    return render_template_string(
        HTML,
        ip=get_ip(),
        action=current_action,
        auto="ON" if auto_mode else "OFF"
    )

@app.route("/forward")
def forward():

    if not auto_mode:
        move_forward()

    return "OK"

@app.route("/backward")
def backward():

    if not auto_mode:
        move_backward()

    return "OK"

@app.route("/left")
def left():

    if not auto_mode:
        turn_left()

    return "OK"

@app.route("/right")
def right():

    if not auto_mode:
        turn_right()

    return "OK"

@app.route("/stop")
def stop_route():

    global auto_mode

    stop()

    return "STOPPED"

@app.route("/toggle_auto")
def toggle_auto():

    global auto_mode

    auto_mode = not auto_mode

    if not auto_mode:
        stop()

    return "AUTO TOGGLED"

# =========================================================
# VIDEO FEED
# =========================================================
@app.route('/video_feed')
def video_feed():

    return Response(
        generate_frames(),
        mimetype='multipart/x-mixed-replace; boundary=frame'
    )

# =========================================================
# CLEANUP
# =========================================================
def cleanup():

    stop()

    camera.release()

    GPIO.cleanup()

# =========================================================
# MAIN
# =========================================================
if __name__ == "__main__":

    try:

        print("Starting Orange Auto Rover...")
        print(f"Open browser: http://{get_ip()}:5000")

        app.run(
            host="0.0.0.0",
            port=5000,
            threaded=True,
            debug=False
        )

    finally:

        cleanup()


